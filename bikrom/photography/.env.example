# Estefanía Torres Fotografía — variables de entorno (sin secretos reales).
# En Render se definen en Environment; nunca en el código ni en archivos públicos.

# Obligatorias en producción
APP_SECRET=                 # 32+ caracteres aleatorios (firma cookies y cifra el token de Google)
PHOTO_ADMIN_PASSWORD=       # contraseña del panel (mínimo 10 caracteres)
SITE_URL=https://bikrom.com
NODE_ENV=production

# Datos (base SQLite). En Render con disco: /var/data
# DATA_DIR=/var/data
# PHOTO_DATA_DIR=

# Almacenamiento de archivos: local (por defecto) o s3 (Cloudflare R2, Backblaze B2, AWS)
STORAGE_DRIVER=local
S3_ENDPOINT=                # p. ej. https://<cuenta>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Pagos con tarjeta (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_ENV=sandbox          # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Correo (Resend)
RESEND_API_KEY=
PHOTO_EMAIL_FROM=           # p. ej. Estefanía Torres <hola@tu-dominio> (dominio verificado)

# Disparador externo de tareas (opcional, para hosting que se suspende)
CRON_SECRET=
