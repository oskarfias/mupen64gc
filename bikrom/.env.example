# Copia este archivo como .env y llena los valores.
PORT=3000
SITE_URL=https://[DOMINIO]

# Panel de administración (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=[CONTRASEÑA DEL PANEL]

# Pagos: elige uno o ambos (stripe | mercadopago)
PAYMENT_PROVIDERS=stripe,mercadopago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precio recurrente de Stripe para la Membresía
STRIPE_PRICE_MEMBRESIA_BASICA=
STRIPE_PRICE_MEMBRESIA_PLUS=
MERCADOPAGO_ACCESS_TOKEN=

# Correo transaccional (Resend). Sin clave, los correos se guardan en data/outbox.json
RESEND_API_KEY=
EMAIL_FROM=Bikrom <hola@[DOMINIO]>
EMAIL_NOTIFY=[CORREO]

# Acceso a cursos (plataforma externa) y vigencia de descargas
COURSE_ACCESS_URL=[URL DE LA PLATAFORMA DE CURSOS]
DOWNLOAD_LINK_DAYS=30
